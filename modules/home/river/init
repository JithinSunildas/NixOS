#!/usr/bin/env fish

# ==============================================================================
# 1. WAYLAND & GTK ENVIRONMENT FIXES
# ==============================================================================
riverctl spawn "dbus-update-activation-environment SEATD_SOCK DISPLAY WAYLAND_DISPLAY XDG_CURRENT_DESKTOP=river"

# ==============================================================================
# 2. INPUT DEVICES (Keyboard & Touchpad)
# ==============================================================================
riverctl keyboard-layout -options "compose:ralt" us
riverctl focus-follows-cursor normal

# Touchpad gestures and speeds
riverctl input "pointer-*" tap enabled
riverctl input "pointer-*" natural-scroll enabled
riverctl input "pointer-*" accel-speed 0.8

# ==============================================================================
# 3. DISPLAYS & COSMETICS
# ==============================================================================
# Borders (2px, warm active color, gray inactive)
riverctl border-width 2
riverctl border-color-focused "0xffffc87f"
riverctl border-color-unfocused "0xff505050"
riverctl border-color-urgent "0xff9b0000"

# ==============================================================================
# 4. BACKGROUND DAEMONS
# ==============================================================================
riverctl spawn "pkill waybar; waybar"
riverctl spawn "pkill awww-daemon; awww-daemon"
riverctl spawn "pkill swayosd-server; swayosd-server"
riverctl spawn "pkill swaync; swaync"

# ==============================================================================
# 5. KEYBINDINGS
# ==============================================================================
set MOD Mod4

# --- Application Launchers ---
riverctl map normal $MOD Return spawn "env GSK_RENDERER=gl ghostty"
riverctl map normal $MOD E spawn nautilus
riverctl map normal $MOD B spawn zen-beta
riverctl map normal $MOD O spawn obsidian
riverctl map normal $MOD N spawn "ghostty -e nmtui"
riverctl map normal $MOD Y spawn "ghostty -e yazi"
riverctl map normal $MOD+Shift N spawn "ghostty -e nvim"
riverctl map normal $MOD+Shift C spawn gnome-calculator
riverctl map normal $MOD Space spawn "pkill fuzzel || fuzzel"
riverctl map normal Alt Space spawn "pkill wlogout || wlogout"
riverctl map normal $MOD+Shift Space spawn "pkill waybar || waybar"

# --- OCR / Screenshot Snippet ---
riverctl map normal $MOD S spawn "sh -c 'grim -g \"\$(slurp)\" - | tesseract - - | wl-copy && notify-send \"OCR\" \"Text copied to clipboard\"'"

# --- Window Administration ---
riverctl map normal $MOD Q close
riverctl map normal $MOD+Shift P spawn "riverctl power-off-monitors"
# Live reload by re-executing this script
riverctl map normal $MOD+Shift R spawn "$HOME/nix-config/modules/home/river/init"

# --- Navigation & Window Swapping (HJKL) ---
riverctl map normal $MOD H focus-view previous
riverctl map normal $MOD J focus-view next
riverctl map normal $MOD K focus-view previous
riverctl map normal $MOD L focus-view next

riverctl map normal $MOD+Shift H swap previous
riverctl map normal $MOD+Shift J swap next
riverctl map normal $MOD+Shift K swap previous
riverctl map normal $MOD+Shift L swap next

# --- Window States & Layout Controls ---
riverctl map normal $MOD V toggle-float
riverctl map normal $MOD+Shift F toggle-fullscreen

# --- Mouse / Pointer Drags ---
# Hold Super + Left Click to drag floating windows, Right Click to resize
riverctl map-pointer normal $MOD BTN_LEFT move-view
riverctl map-pointer normal $MOD BTN_RIGHT resize-view

# --- Media & Hardware Keys (SwayOSD) ---
# Map for both normal and locked states using a loop
for mode in normal locked
    riverctl map $mode None XF86AudioRaiseVolume spawn "swayosd-client --output-volume raise"
    riverctl map $mode None XF86AudioLowerVolume spawn "swayosd-client --output-volume lower"
    riverctl map $mode None XF86AudioMute spawn "swayosd-client --output-volume mute-toggle"
    riverctl map $mode None XF86AudioMicMute spawn "swayosd-client --input-volume mute-toggle"
    riverctl map $mode None XF86MonBrightnessUp spawn "swayosd-client --brightness raise"
    riverctl map $mode None XF86MonBrightnessDown spawn "swayosd-client --brightness lower"
end

# ==============================================================================
# 6. WORKSPACES (Tags 1-9)
# ==============================================================================
for i in (seq 1 9)
    # Correct fish math bitwise shift
    set tags (math "1 << ($i - 1)")
    riverctl map normal $MOD $i set-focused-tags $tags
    riverctl map normal $MOD+Shift $i set-view-tags $tags
end

# ==============================================================================
# 7. WINDOW RULES (Floating & Overlays)
# ==============================================================================
# River-classic uses float-filter-add instead of rule-add
riverctl float-filter-add title "Picture in picture"
riverctl float-filter-add app-id "swaync"
riverctl float-filter-add app-id "waybar"

# ==============================================================================
# 8. LAYOUT ENGINE (Stacktile Dwindle)
# ==============================================================================
riverctl default-layout stacktile

pkill rivertile
pkill rivercarro
pkill stacktile

# Start stacktile with primary and secondary layout rules set to dwindle
stacktile --primary-count 1 --primary-layout dwindle --secondary-layout dwindle &
